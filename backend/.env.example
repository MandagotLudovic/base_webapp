NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=template_app
DB_USER=postgres
DB_PASSWORD=postgres

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=changez-moi-secret-access-minimum-32-caracteres
JWT_REFRESH_SECRET=changez-moi-secret-refresh-minimum-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:8080